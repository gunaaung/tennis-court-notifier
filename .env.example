# LINE Messaging API credentials (from LINE Developers Console)
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here
LINE_USER_ID=your_user_id_or_group_id_here

# Schedule configuration
DAYS_AHEAD=2
TARGET_HOURS=18,19,20
SKIP_PAST_HOURS=true
BEAT_EXCLUDE_KID_COURTS=true
